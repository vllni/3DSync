# Copy to .env. HOST_IP is the address the 3DS reaches this machine on;
# FTP hands it out in PASV replies and it goes into the TLS certificates.
HOST_IP=192.168.1.10

TEST_USER=3dsync
TEST_PASSWORD=3dsync

# All above 1024 so rootless podman can bind them without a sysctl.
# 3DSync.ini takes the port as Port= for FTP, in the Url for WebDAV, and as
# Server=host:port for SMB (libsmb2 parses it; there is no Port= there).
SMB_PORT=1445
FTP_PORT=2121
FTPS_IMPLICIT_PORT=2990
FTP_PLAIN_PORT=2122
FTP_ANON_PORT=2123
FTP_ANON_STOCK_PORT=2124
WEBDAV_HTTP_PORT=8080
WEBDAV_HTTPS_PORT=8443
